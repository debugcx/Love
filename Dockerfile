# syntax=docker/dockerfile:1

# ---- 构建阶段：生成静态站点 ----
# NUXT_PUBLIC_* 是公开的前端配置（anon key 本身就是公开密钥）。
# nuxt generate 是纯静态构建，这些变量必须在构建期注入，改配置后需要重新 build。
FROM node:22-alpine AS build

WORKDIR /app

# 先复制依赖清单，利用 Docker 层缓存加速重复构建
COPY package.json package-lock.json nuxt.config.ts tsconfig.json ./
RUN npm ci --no-audit --no-fund

COPY . .

ARG NUXT_PUBLIC_SUPABASE_URL=""
ARG NUXT_PUBLIC_SUPABASE_ANON_KEY=""
ARG NUXT_PUBLIC_AMAP_KEY=""
ARG NUXT_PUBLIC_AMAP_SECURITY_CODE=""
ARG NUXT_PUBLIC_ZEGO_APP_ID=""
ARG NUXT_PUBLIC_ZEGO_APPSIGN=""
ARG NUXT_PUBLIC_ZEGO_SERVER=""
ARG NUXT_PUBLIC_TURN_URLS=""
ARG NUXT_PUBLIC_TURN_USERNAME=""
ARG NUXT_PUBLIC_TURN_CREDENTIAL=""
ARG NUXT_PUBLIC_APP_VERSION=""
ARG NUXT_PUBLIC_UPDATE_MANIFEST_URL=""

ENV NUXT_PUBLIC_SUPABASE_URL=$NUXT_PUBLIC_SUPABASE_URL \
    NUXT_PUBLIC_SUPABASE_ANON_KEY=$NUXT_PUBLIC_SUPABASE_ANON_KEY \
    NUXT_PUBLIC_AMAP_KEY=$NUXT_PUBLIC_AMAP_KEY \
    NUXT_PUBLIC_AMAP_SECURITY_CODE=$NUXT_PUBLIC_AMAP_SECURITY_CODE \
    NUXT_PUBLIC_ZEGO_APP_ID=$NUXT_PUBLIC_ZEGO_APP_ID \
    NUXT_PUBLIC_ZEGO_APPSIGN=$NUXT_PUBLIC_ZEGO_APPSIGN \
    NUXT_PUBLIC_ZEGO_SERVER=$NUXT_PUBLIC_ZEGO_SERVER \
    NUXT_PUBLIC_TURN_URLS=$NUXT_PUBLIC_TURN_URLS \
    NUXT_PUBLIC_TURN_USERNAME=$NUXT_PUBLIC_TURN_USERNAME \
    NUXT_PUBLIC_TURN_CREDENTIAL=$NUXT_PUBLIC_TURN_CREDENTIAL \
    NUXT_PUBLIC_APP_VERSION=$NUXT_PUBLIC_APP_VERSION \
    NUXT_PUBLIC_UPDATE_MANIFEST_URL=$NUXT_PUBLIC_UPDATE_MANIFEST_URL

RUN npm run generate

# ---- 运行阶段：nginx 托管静态文件 ----
FROM nginx:1.27-alpine AS runtime

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/.output/public /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s \
  CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1
